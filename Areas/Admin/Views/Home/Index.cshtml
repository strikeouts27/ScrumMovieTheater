@{
    ViewData["Title"] = "Admin Dashboard";
}
<link rel="stylesheet" href="~/css/Admin.css" />

<div class="dashboard">

    <div class="title">🎬 Admin Dashboard</div>
    <div class="subtitle">Manage movies, shows, and bookings</div>

    <div class="card-grid">

        <a asp-area="Admin" asp-controller="Movie" asp-action="AddMovie" class="card-box">
            <div class="card-title">➕ Add Movie</div>
            <div class="card-text">Create a new movie entry in the system</div>
        </a>

        <a asp-area="Admin" asp-controller="Movie" asp-action="AddShowTime" class="card-box">
            <div class="card-title">🕒 Add ShowTime</div>
            <div class="card-text">Schedule a movie in a theater</div>
        </a>


        <a asp-area="Admin" asp-controller="Movie" asp-action="Index" class="card-box">
            <div class="card-title">🎞 Manage Movies</div>
            <div class="card-text">View, edit, or delete movies</div>
        </a>

        <a asp-area="Admin"
           asp-controller="Movie"
           asp-action="ManageShowtimes"
           class="card-box">
            <div class="card-title">📋 Manage Showtimes</div>
            <div class="card-text">View and update scheduled movies</div>
        </a>

        <a asp-area="Admin" asp-controller="Movie" asp-action="Bookings" class="card-box">
            <div class="card-title">🎟 Bookings</div>
            <div class="card-text">View all customer bookings</div>
        </a> 
        <a asp-area="Admin"
           asp-controller="Theater"
           asp-action="Index"
           class="card-box">

            <div class="card-title">
                🎬 Manage Theaters
            </div>

            <div class="card-text">
                Add, edit, and deactivate theaters
            </div>

        </a>
        <a asp-area="Admin"
           asp-controller="Auditorium"
           asp-action="Index"
           class="card-box">

            <div class="card-title">🎬 Auditoriums</div>
            <div class="card-text">Manage screens and seating capacity</div>

        </a>
        <a asp-area="Admin"
           asp-controller="Reports"
           asp-action="Sales"
           class="card-box">

            <div class="card-title">📊 Sales Reports</div>
            <div class="card-text">View ticket sales by theater and date range</div>
        </a>

        <a asp-area="Admin" asp-controller="Movie" asp-action="BoxOfficePurchase" class="card-box">
            <div class="card-title">🎟️ Tickets</div>
            <div class="card-text">Sell tickets</div>
        </a>
        <a asp-area="Admin"
           asp-controller="Reports"
           asp-action="ConcessionSales"
           class="card-box">
            
            <div class="card-title">🍿 Concession Sales</div>
           <div class="card-text">View concession sales reports </div>
           
        </a>

    </div>

</div>