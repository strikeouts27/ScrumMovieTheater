@{
    ViewData["Title"] = "Home Page";
}

<!-- NOTE: Placeholders currently being used for images --> 

<!-- Partial View for Carousel -->
<partial name="~/Views/Shared/_Carousel.cshtml" />

<!-- MOVIE SECTION -->
<div class="container">

    <!-- ROW 1: Three equal movies -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card h-100">
                <img src="https://images.placeholders.dev/"
                class="card-img-top movie-img">

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Movie 1</h5>

                    <p class="card-text">
                        <span>An exciting movie description goes here.</span>
                        <span>Discover the story, characters, and adventure!</span>
                    </p>

                    <div class="mt-auto text-end">
                        <button class="btn btn-primary">Buy</button>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <img src="https://images.placeholders.dev/" class="card-img-top movie-img">
                <div class="card-body">
                    <h5>Movie 2</h5>
                    
                    <p class="card-text">
                        <span>An exciting movie description goes here.</span>
                        <span>Discover the story, characters, and adventure!</span>
                    </p>

                    <div class="mt-auto text-end">
                        <button class="btn btn-primary">Buy</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <img src="https://images.placeholders.dev/" class="card-img-top movie-img">
                <div class="card-body">
                    <h5>Movie 3</h5>
                    <p class="card-text">
                        <span>An exciting movie description goes here.</span>
                        <span>Discover the story, characters, and adventure!</span>
                    </p>

                    <div class="mt-auto text-end">
                        <button class="btn btn-primary">Buy</button>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- ROW 2: Four equal movies -->
    <div class="row g-3 mb-4">

        @for (int i = 4; i <= 7; i++)
        {
            <div class="col-6 col-md-3">
                <div class="card">
                    <img src="https://images.placeholders.dev/"
                         class="card-img-top movie-img">
                    <div class="card-body">
                        <h5>Movie @i</h5>
                        <p class="card-text">
                            <span>An exciting movie description goes here.</span>
                            <span>Discover the story, characters, and adventure!</span>
                        </p>

                        <div class="mt-auto text-end">
                            <button class="btn btn-primary">Buy</button>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>


    <!-- ROW 3: One wide and two narrow -->
    <div class="row g-3">

        <div class="col-md-6">
            <div class="card">
                <img src="https://images.placeholders.dev/"
                     class="card-img-top featured-img">
                <div class="card-body">
                    <h5>Featured Movie</h5>
                    <p class="card-text">
                        <span>An exciting movie description goes here.</span>
                        <span>Discover the story, characters, and adventure!</span>
                    </p>

                    <div class="mt-auto text-end">
                        <button class="btn btn-primary">Buy</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card">
                <img src="https://images.placeholders.dev/"
                     class="card-img-top movie-img">
                <div class="card-body">
                    <h5>Movie 9</h5>
                    <p class="card-text">
                        <span>An exciting movie description goes here.</span>
                        <span>Discover the story, characters, and adventure!</span>
                    </p>

                    <div class="mt-auto text-end">
                        <button class="btn btn-primary">Buy</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card">
                <img src="https://images.placeholders.dev/"
                     class="card-img-top movie-img">
                <div class="card-body">
                    <h5>Movie 10</h5>
                    <p class="card-text">
                        <span>An exciting movie description goes here.</span>
                        <span>Discover the story, characters, and adventure!</span>
                    </p>

                    <div class="mt-auto text-end">
                        <button class="btn btn-primary">Buy</button>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

<!-- SPECIAL OFFERS SECTION -->
<div class="container my-5">

    <h2 class="mb-4">Special Offers</h2>

    <!-- Featured Offer -->
    <div class="card text-white bg-primary mb-4">
        <div class="card-body p-5 text-center">

            <h2 class="card-title">
                Movie Night Special!
            </h2>

            <h1 class="display-3 fw-bold">
                30% OFF
            </h1>

            <p class="lead">
                Get 30% off of admission!
            </p>

            <p>
                Use promotional code:
                <strong>MOVIENIGHT</strong>
            </p>

            <a href="#" class="btn btn-warning btn-lg">
                Shop Movies
            </a>

        </div>
    </div>


    <!-- Additional Offers -->
    <div class="row g-4">

        <div class="col-md-6">
            <div class="card h-100">

                <img src="https://images.placeholders.dev/"
                     class="card-img-top"
                     alt="Movie bundle offer">

                <div class="card-body">
                    <h5 class="card-title">Bundle Deal</h5>

                    <p class="card-text">
                        Get a free popcorn and drink with admission!
                    </p>

                    <a href="#" class="btn btn-outline-primary">
                        Learn More
                    </a>
                </div>

            </div>
        </div>


        <div class="col-md-6">
            <div class="card h-100">

                <img src="https://images.placeholders.dev/"
                     class="card-img-top"
                     alt="Weekend movie offer">

                <div class="card-body">
                    <h5 class="card-title">Weekend Special</h5>

                    <p class="card-text">
                        Enjoy special admission pricing
                        every weekend.
                    </p>

                    <a href="#" class="btn btn-outline-primary">
                        Learn More
                    </a>
                </div>

            </div>
        </div>

    </div>

</div>