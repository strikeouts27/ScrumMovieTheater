@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">

    <h1 class="display-4 mb-4">Privacy Policy</h1>

    <p class="lead">
        At <strong>Scrum Movie Theater</strong>, we are committed to protecting
        your privacy and ensuring your personal information is handled securely.
    </p>

    <hr />

    <h3>Information We Collect</h3>

    <p>
        We may collect the following information when you use our website:
    </p>

    <ul>
        <li>Name</li>
        <li>Email address</li>
        <li>Movie ticket booking information</li>
        <li>Contact messages submitted through our website</li>
    </ul>

    <h3>How We Use Your Information</h3>

    <ul>
        <li>Process movie ticket reservations.</li>
        <li>Respond to customer inquiries.</li>
        <li>Improve our website and customer experience.</li>
        <li>Provide customer support when needed.</li>
    </ul>

    <h3>Data Protection</h3>

    <p>
        We use appropriate security measures to help protect your personal
        information from unauthorized access, disclosure, or misuse.
    </p>

    <h3>Third-Party Services</h3>

    <p>
        Scrum Movie Theater does not sell or rent your personal information to
        third parties. External websites linked from our site have their own
        privacy policies.
    </p>

    <h3>Your Rights</h3>

    <p>
        You may contact us at any time if you would like to review, update, or
        request the removal of your personal information.
    </p>

    <h3>Contact Us</h3>

    <p>
        If you have any questions regarding this Privacy Policy, please visit
        our Contact page or email our support team.
    </p>

    <hr />

    <p class="text-muted">
        Last Updated: July 2026
    </p>

</div>