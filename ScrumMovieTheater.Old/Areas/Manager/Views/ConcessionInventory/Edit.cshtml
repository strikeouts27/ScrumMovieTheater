@model ScrumMovieTheater.Models.ConcessionInventory

<h2>Edit Concession Inventory</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="InventoryId" />


    <div class="form-group">
        <label>Concession Item</label>
        <input value="@Model.ConcessionItem.Name" class="form-control" readonly />
    </div>


    <div class="form-group">
        <label>Theater</label>
        <input value="@Model.Theater.Name" class="form-control" readonly />
    </div>


    <div class="form-group">
        <label>Quantity On Hand</label>
        <input asp-for="QuantityOnHand" class="form-control" />
    </div>


    <button type="submit" class="btn btn-success">
        Save Changes
    </button>

</form>