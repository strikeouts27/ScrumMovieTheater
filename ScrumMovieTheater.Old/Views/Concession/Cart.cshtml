@model List<ScrumMovieTheater.Models.ConcessionCartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    decimal total = Model?.Sum(i => i.Subtotal) ?? 0;
}

<div class="container mt-5">

    <h2 class="mb-4">Shopping Cart</h2>

    @if (TempData["CartMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["CartMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Your cart is empty.
        </div>

        <a href="/Concession"
           class="btn btn-primary">
            Continue Shopping
        </a>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Subtotal</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>

                        <td>@item.Price.ToString("C")</td>

                        <td>
                            <form action="/Concession/UpdateQuantity"
                                  method="post"
                                  class="d-flex gap-2">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="concessionItemId"
                                       value="@item.ConcessionItemId" />

                                <input type="number"
                                       name="quantity"
                                       value="@item.Quantity"
                                       min="1"
                                       class="form-control"
                                       style="width: 90px;" />

                                <button type="submit"
                                        class="btn btn-warning">
                                    Update
                                </button>
                            </form>
                        </td>

                        <td>@item.Subtotal.ToString("C")</td>

                        <td>
                            <form action="/Concession/RemoveFromCart"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="concessionItemId"
                                       value="@item.ConcessionItemId" />

                                <button type="submit"
                                        class="btn btn-danger">
                                    Remove
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end">
            <h3>Total: @total.ToString("C")</h3>
        </div>

        <div class="mt-3">
            <a href="/Concession"
               class="btn btn-secondary">
                Continue Shopping
            </a>

            <a href="/Concession/Checkout"
               class="btn btn-success">
                Checkout
            </a>
        </div>
    }
</div>