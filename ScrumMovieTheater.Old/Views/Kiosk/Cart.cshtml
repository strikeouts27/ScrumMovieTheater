@model List<ScrumMovieTheater.Models.ConcessionCartItem>

@{
    ViewData["Title"] = "Review Order";
    decimal total = Model.Sum(i => i.Subtotal);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/kiosk.css"
          asp-append-version="true" />
}

<div class="kiosk-page">

    <header class="kiosk-header">
        <h1 class="kiosk-title">
            Review Your Order
        </h1>
    </header>

    <!-- Progress Bar -->
    <div class="kiosk-progress">

        <div class="kiosk-progress-step complete">
            <span class="kiosk-progress-number">✓</span>
            <span>Select Items</span>
        </div>

        <div class="kiosk-progress-line"></div>

        <div class="kiosk-progress-step active">
            <span class="kiosk-progress-number">2</span>
            <span>Review Order</span>
        </div>

        <div class="kiosk-progress-line"></div>

        <div class="kiosk-progress-step">
            <span class="kiosk-progress-number">3</span>
            <span>Checkout</span>
        </div>

        <div class="kiosk-progress-line"></div>

        <div class="kiosk-progress-step">
            <span class="kiosk-progress-number">4</span>
            <span>Complete</span>
        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="kiosk-cart-panel">

            <h2>Your Order is Empty</h2>

            <a asp-controller="Kiosk"
               asp-action="Index"
               class="kiosk-cart-button">
                Start Ordering
            </a>

        </div>
    }
    else
    {
        <div class="kiosk-cart-panel">

            @foreach (var item in Model)
            {
                <div class="border-bottom py-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h3>@item.Name</h3>

                            <div>
                                @item.Price.ToString("C")
                            </div>

                        </div>

                        <div class="text-end">

                            <div>
                                Qty: @item.Quantity
                            </div>

                            <div class="fw-bold">
                                @item.Subtotal.ToString("C")
                            </div>

                        </div>

                    </div>

                    <div class="mt-3 d-flex gap-2">

                        <form asp-action="DecreaseQuantity"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="concessionItemId"
                                   value="@item.ConcessionItemId" />

                            <button class="kiosk-quantity-button">
                                −
                            </button>

                        </form>

                        <form asp-action="IncreaseQuantity"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="concessionItemId"
                                   value="@item.ConcessionItemId" />

                            <button class="kiosk-quantity-button">
                                +
                            </button>

                        </form>

                        <form asp-action="RemoveFromCart"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="concessionItemId"
                                   value="@item.ConcessionItemId" />

                            <button class="btn btn-danger btn-lg">
                                Remove
                            </button>

                        </form>

                    </div>

                </div>
            }

            <hr />

            <div class="d-flex justify-content-between fs-2">

                <strong>Total</strong>

                <strong>
                    @total.ToString("C")
                </strong>

            </div>

            <div class="mt-4 d-grid gap-3">

                <a asp-action="Index"
                   class="kiosk-cart-button">
                    Continue Shopping
                </a>

                <a asp-action="Checkout"
                   class="kiosk-add-button text-center text-decoration-none">
                    Continue to Checkout
                </a>

            </div>

        </div>
    }

</div>