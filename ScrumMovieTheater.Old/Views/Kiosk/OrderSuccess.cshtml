@model ScrumMovieTheater.Models.Order

@{
    ViewData["Title"] = "Order Complete";

    var total = Model.OrderItems?
        .Sum(item => item.Price * item.Quantity) ?? 0;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/kiosk.css"
          asp-append-version="true" />
}

<div class="kiosk-page">

    <header class="kiosk-header">
        <h1 class="kiosk-title">
            Order Complete
        </h1>

        <p class="kiosk-subtitle">
            Your concession order was placed successfully
        </p>
    </header>

    <div class="kiosk-progress">

        <div class="kiosk-progress-step complete">
            <span class="kiosk-progress-number">✓</span>
            <span>Select Items</span>
        </div>

        <div class="kiosk-progress-line"></div>

        <div class="kiosk-progress-step complete">
            <span class="kiosk-progress-number">✓</span>
            <span>Review Order</span>
        </div>

        <div class="kiosk-progress-line"></div>

        <div class="kiosk-progress-step complete">
            <span class="kiosk-progress-number">✓</span>
            <span>Checkout</span>
        </div>

        <div class="kiosk-progress-line"></div>

        <div class="kiosk-progress-step active">
            <span class="kiosk-progress-number">4</span>
            <span>Complete</span>
        </div>

    </div>

    <div class="kiosk-cart-panel">

        <div class="alert alert-success text-center">
            <h2 class="mb-3">
                Thank You!
            </h2>

            <p class="fs-4 mb-0">
                Your order has been received.
            </p>
        </div>

        <div class="text-center my-5">

            <p class="fs-4 mb-2">
                Order Number
            </p>

            <div class="display-2 fw-bold text-warning">
                #@Model.OrderId
            </div>

        </div>

        <div class="mb-4">

            <p class="fs-4">
                <strong>Booking ID:</strong>
                @Model.BookingId
            </p>

            <p class="fs-4">
                <strong>Order Date:</strong>
                @Model.OrderDate.ToString("g")
            </p>

        </div>

        <h2 class="mb-4">
            Order Summary
        </h2>

        @foreach (var item in Model.OrderItems)
        {
            <div class="border-bottom py-3">

                <div class="d-flex justify-content-between">

                    <strong>
                        @item.ConcessionItem?.Name
                    </strong>

                    <strong>
                        @((item.Price * item.Quantity).ToString("C"))
                    </strong>

                </div>

                <div>
                    Quantity: @item.Quantity
                </div>

            </div>
        }

        <hr />

        <div class="d-flex justify-content-between fs-2 mb-5">

            <strong>Total</strong>

            <strong>
                @total.ToString("C")
            </strong>

        </div>

        <a asp-controller="Kiosk"
           asp-action="Index"
           class="kiosk-cart-button">
            Start New Order
        </a>

    </div>

</div>