@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section style="
    min-height: 75vh;
    padding: 60px 20px;
    background: #42070d;
    color: white;
">
    <div class="container">
        <h1 style="color: #f4c453; margin-bottom: 25px;">
            Privacy Policy
        </h1>

        <p>
            At <strong>Scrum Movie Theater</strong>, we are committed to
            protecting your privacy and handling your personal information
            responsibly.
        </p>

        <hr style="border-color: #f4c453;" />

        <h3 style="color: #f4c453;">Information We Collect</h3>

        <ul>
            <li>Name</li>
            <li>Email address</li>
            <li>Movie ticket booking information</li>
            <li>Messages submitted through the Contact page</li>
        </ul>

        <h3 style="color: #f4c453;">How We Use Your Information</h3>

        <ul>
            <li>Process movie ticket bookings.</li>
            <li>Respond to customer questions.</li>
            <li>Provide customer support.</li>
            <li>Improve our website and services.</li>
        </ul>

        <h3 style="color: #f4c453;">Information Security</h3>

        <p>
            We take reasonable steps to protect your personal information from
            unauthorized access, disclosure, alteration, or misuse.
        </p>

        <h3 style="color: #f4c453;">Third-Party Services</h3>

        <p>
            Scrum Movie Theater does not sell your personal information.
            External websites linked from our application may have their own
            privacy policies.
        </p>

        <h3 style="color: #f4c453;">Contact Us</h3>

        <p>
            For questions about this Privacy Policy, please visit our Contact
            page or contact our customer-support team.
        </p>

        <p style="color: #d1d5db; margin-top: 30px;">
            Last updated: July 2026
        </p>
    </div>
</section>