<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ScrumMovieTheater</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@400;500;600;700&family=Barlow+Semi+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theater-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ScrumMovieTheater.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold fs-4 theater-brand" asp-controller="Home" asp-action="Index">
                    Scrum Movie Theater
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-controller="Movies"
                               asp-action="Index">
                                Movies
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-controller="Showtimes"
                               asp-action="Index">
                                Showtimes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-controller="Concession"
                               asp-action="Index">
                                Concessions
                            </a>
                      </li>
                      <li class="nav-item">
                        <a class="nav-link text-white"
                           asp-area=""
                           asp-controller="Kiosk"
                           asp-action="Index">
                            Kiosk
                        </a>
                      </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Theater" asp-action="Index">Theater</a>
                        </li>

                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Account" asp-action="Profile">@User.Identity.Name</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>

                    <form class="d-flex" asp-controller="Movies" asp-action="Index" method="get" role="search">
                        <input class="form-control me-2" type="search" name="q" placeholder="Search movies" aria-label="Search movies">
                        <button class="btn btn-outline-light" type="submit">Search</button>
                    </form>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="nav-link ms-3"
                           asp-area="Admin"
                           asp-controller="Home"
                           asp-action="Index">
                            Admin
                        </a>
                    }

                    @if (User.IsInRole("Manager"))
                    {
                        <a class="nav-link ms-3"
                           asp-area="Manager"
                           asp-controller="Home"
                           asp-action="Index">
                            Manager
                        </a>
                    }
                </div>
            </div>
        </nav>
        <div class="marquee-rail"></div>
    </header>

    <div class="container-fluid px-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div class="marquee-rail"></div>
    <footer class="border-top footer bg-dark py-3">
        <div class="container text-center">
            <span class="footer-text">&copy; 2026 - ScrumMovieTheater - </span><a asp-area="" asp-controller="Home" asp-action="Privacy" class="footer-link">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>